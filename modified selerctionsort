#include <stdio.h>

void selectionSort(int arr[], int size)
{
    int i, j, min_index, temp;

    for(i = 0; i < size - 1; i++)
    {
        min_index = i;

        for(j = i + 1; j < size; j++)
        {
            if(arr[j] < arr[min_index])
            {
                min_index = j;
            }
        }

        // Swap elements
        temp = arr[i];
        arr[i] = arr[min_index];
        arr[min_index] = temp;
    }
}

int main()
{
    int arr[5] = {7, 2, 6, 9, 1};
    int size = 5;
    int i;

    printf("Original array: ");
    for(i = 0; i < size; i++)
    {
        printf("%d ", arr[i]);
    }

    selectionSort(arr, size);

    printf("\nSorted array: ");
    for(i = 0; i < size; i++)
    {
        printf("%d ", arr[i]);
    }

    return 0;
}
