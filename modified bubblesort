#include <stdio.h>

void modifiedBubbleSort(int arr[], int size)
{
    int i, j, temp, swapped;

    for(i = 0; i < size - 1; i++)
    {
        swapped = 0;

        for(j = 0; j < size - i - 1; j++)
        {
            if(arr[j] > arr[j + 1])
            {
                temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;

                swapped = 1;
            }
        }

        if(swapped == 0)
        {
            break;
        }
    }
}

int main()
{
    int arr[5] = {7, 2, 6, 9, 1};
    int i;

    printf("Original array: ");
    for(i = 0; i < 5; i++)
        printf("%d ", arr[i]);

    modifiedBubbleSort(arr, 5);

    printf("\nSorted array: ");
    for(i = 0; i < 5; i++)
        printf("%d ", arr[i]);

    return 0;
}
