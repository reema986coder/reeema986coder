#include <stdio.h>

void modifiedInsertionSort(int arr[], int size)
{
    int i, j, key;

    for(i = 1; i < size; i++)
    {
        key = arr[i];
        j = i - 1;

        while(j >= 0 && arr[j] > key)
        {
            arr[j + 1] = arr[j];
            j--;
        }

        arr[j + 1] = key;
    }
}

int main()
{
    int arr[5] = {7, 2, 6, 9, 1};
    int i;

    printf("Original array: ");
    for(i = 0; i < 5; i++)
        printf("%d ", arr[i]);

    modifiedInsertionSort(arr, 5);

    printf("\nSorted array: ");
    for(i = 0; i < 5; i++)
        printf("%d ", arr[i]);

    return 0;
}
