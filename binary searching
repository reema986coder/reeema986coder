 #include<stdio.h>
int binarysearching(int arr[],int size,int key){
    int low=0;
    int high= size-1;
    while(low<high){
        int mid = low+(high - low)/2;
    
    if(arr[mid]==key){
        return mid;
        
    }
    if(arr[mid]< key){
        low=mid+1;
    }
    else{
        high=mid-1;
    }
}
    return -1;
}

int main(){
    int arr[4]={8 ,5 ,3 ,4 };
    int size = sizeof(arr)/sizeof(arr[0]);
    int key = 25;
   int result= binarysearching(arr,size,key);
    if(result!= -1){
      printf("the key is found at index=%d", result);
    }
    else{  
        printf("the key is  not found" );
        }
    return 0;
}
