#include <stdio.h>
 int bubblesort(int arr[],int size){
     for( int step=0; step < size-1; step++ ){
         for( int i = 0;i < size-step-1; i++){
             if(arr[i] > arr[i+1]){
                 int temp = arr[i];
                 arr[i]= arr[i+1];
                 arr[i+1] = temp ;
                 
             }
         }
         for( int i = 0; i<size ;i++){
             printf("%d",arr[i]);
         }
         printf("\n");
     }
     
 }
int main (){
   int arr[4] = {7,6,9,2,};
    int size = sizeof(arr)/sizeof(arr[0]);
    bubblesort(arr,size);
    printf("sorted array:");
    for( int i = 0; i<size; i++){
        printf("%d", arr[i]);
        
    }
    return 0;
}
    
