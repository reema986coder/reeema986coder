#include <stdio.h>


long long factorial(int n);

int main() {
    int num;
    long long fact;

    printf("Enter a positive integer: ");
    scanf("%d", &num);

    
    if (num < 0) {
        printf("Factorial of a negative number doesn't exist.\n");
    } else {
        fact = factorial(num);
        printf("Factorial of %d = %lld\n", num, fact);
    }

    return 0;
}


long long factorial(int n) {
   
    if (n == 0 || n == 1) {
        return 1;
    }
    // Recursive case: n! = n * (n-1)!
    return n * factorial(n - 1);
}
