#include <stdio.h>
int delete(int arr[],int pos,int n){
    for( int i = pos; i < n-1;i++){
        arr[i]= arr[i+1] ;
    }
     printf("Array after deletion:\n");

    for(int i = 0; i < n - 1; i++)
    {
        printf("%d ", arr[i]);
    } 
}

int main (){
    int arr[6]={ 5,6,6,4,3,1};
    int pos = 2;
    int n = 6;
    delete(arr,pos,n);
}
